# Copia este archivo a `.env.local` para desarrollo, o configúralo en Dokploy (Environment) para producción.
# Las variables con prefijo VITE_ son expuestas al cliente — no metas secretos aquí.

VITE_SANITY_PROJECT_ID=tu_project_id_aqui
VITE_SANITY_DATASET=production

# Cartel "Pròximament..." de pantalla completa mientras la web no está lista para el público.
# - true  → activado (todo el público ve el cartel; el equipo entra con ?preview=pilar2026 para verla por detrás).
# - cualquier otra cosa o vacío → desactivado (web normal).
VITE_COMING_SOON=false
